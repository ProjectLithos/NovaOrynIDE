{
  "version": "0.20.0",
  "feature": "ZIP package-manager format",
  "container": {
    "extension": ".zip",
    "manifest": "NovaOryn.Package.json",
    "format": "novaoryn-package-v1",
    "schemaVersion": 1
  },
  "packageKinds": ["Application", "Driver", "Library", "Service", "KernelExtension"],
  "integrity": ["safe relative paths", "no duplicate entries", "declared payload only", "length verification", "SHA-256 verification"],
  "manager": ["verify", "inspect", "install", "uninstall", "list", "dependency gate", "reverse-dependency gate", "transaction staging", "atomic database update"],
  "policy": {
    "capabilities": "declaration-not-grant",
    "kernelExtensionSigning": "signed-or-trusted"
  },
  "compatibility": {
    "application": ".exe contains .nexe",
    "driver": ".nodrv may be payload inside package ZIP",
    "dynamicLibrary": ".dll",
    "staticLibrary": ".lib"
  }
}
