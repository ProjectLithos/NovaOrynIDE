    "rootTxtFiles": 0,
    "rootPowerShellFiles": 0,
    "rootCmdFiles": 0
  },
  "moves": [
    "Audit-NovaOrynIDE.bat -> Scripts/Audit-NovaOrynIDE.bat",
    "Audit-NovaOrynIDE.ps1 -> Scripts/Audit-NovaOrynIDE.ps1",
    "Install-NovaOrynIDEToolchain.ps1 -> Scripts/Install-NovaOrynIDEToolchain.ps1",
    "Validate-NovaOrynIDEDependencies.ps1 -> Scripts/Validate-NovaOrynIDEDependencies.ps1",
