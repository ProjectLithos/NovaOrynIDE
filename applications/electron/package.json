{
  "name": "@novaoryn/ide-electron",
  "private": true,
  "productName": "NovaOryn IDE",
  "version": "0.2.6",
  "main": "lib/backend/electron-main.js",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "NovaOryn IDE",
        "reloadOnReconnect": true,
        "electron": {
          "appUserModelId": "NovaOryn.IDE",
          "splashScreenOptions": {
            "content": "splash/splash.html",
            "width": 960,
            "height": 540,
            "minDuration": 1200,
            "maxDuration": 30000
          },
          "windowOptions": {
            "icon": "resources/novaoryn-ide.ico"
          }
        },
        "defaultTheme": {
          "light": "light",
          "dark": "dark"
        },
        "preferences": {
          "editor.semanticHighlighting.enabled": true
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": -1,
        "configureProxyFromPreferences": true
      }
    }
  },
  "dependencies": {
    "@novaoryn/ide-extension": "0.2.6",
    "@vscode/windows-ca-certs": "0.3.4",
    "@theia/core": "1.74.0",
    "@theia/editor": "1.74.0",
    "@theia/electron": "1.74.0",
    "@theia/filesystem": "1.74.0",
    "@theia/monaco": "1.74.0",
    "@theia/navigator": "1.74.0",
    "@theia/output": "1.74.0",
    "@theia/preferences": "1.74.0",
    "@theia/process": "1.74.0",
    "@theia/search-in-workspace": "1.74.0",
    "@theia/task": "1.74.0",
    "@theia/terminal": "1.74.0",
    "@theia/workspace": "1.74.0",
    "@theia/debug": "1.74.0"
  },
  "devDependencies": {
    "@theia/cli": "1.74.0",
    "electron": "42.3.0"
  },
  "scripts": {
    "build": "npm run rebuild && theia build --mode development",
    "clean": "theia clean",
    "rebuild": "theia rebuild:electron --cacheRoot ../..",
    "start": "theia start"
  }
}
