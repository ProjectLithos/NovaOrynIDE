<?xml version='1.0' encoding='utf-8'?>
<VSTemplate xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Version="3.0.0" Type="Project">
  <TemplateData>
    <Name>NovaOryn Kernel</Name>
    <Description>Create a freestanding C# NovaOryn kernel workspace (SDK 0.41.2) with an authoritative configuration-driven kernel/userland project graph.</Description>
    <Icon>NovaOrynKernel.ico</Icon>
    <ProjectType>CSharp</ProjectType>
    <LanguageTag>csharp</LanguageTag>
    <PlatformTag>other</PlatformTag>
    <ProjectTypeTag>other</ProjectTypeTag>
    <TemplateID>NovaOryn.Project.Kernel</TemplateID>
    <DefaultName>NovaOrynKernel</DefaultName>
    <SortOrder>1</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
