<?xml version='1.0' encoding='utf-8'?>
<VSTemplate xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Version="3.0.0" Type="Project">
  <TemplateData>
    <Name>NovaOryn Userland Driver</Name>
    <Description>Create an independently compiled user-mode NovaOryn driver process for devices supported by the userland driver model.</Description>
    <Icon>NovaOrynKernel.ico</Icon>
    <ProjectType>CSharp</ProjectType>
    <LanguageTag>csharp</LanguageTag>
    <PlatformTag>other</PlatformTag>
    <ProjectTypeTag>other</ProjectTypeTag>
    <TemplateID>NovaOryn.Project.UserlandDriver</TemplateID>
    <DefaultName>NovaOrynUserlandDriver</DefaultName>
    <SortOrder>22</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
  <TemplateContent>
    <Project File="Template.csproj" ReplaceParameters="true" TargetFileName="$safeprojectname$.csproj">
      <ProjectItem ReplaceParameters="true" OpenInEditor="true" TargetFileName="DriverProgram.cs">DriverProgram.cs</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>