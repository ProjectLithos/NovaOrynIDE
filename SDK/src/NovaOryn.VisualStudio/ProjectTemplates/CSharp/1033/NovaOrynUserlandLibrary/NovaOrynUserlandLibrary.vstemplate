<?xml version='1.0' encoding='utf-8'?>
<VSTemplate xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Version="3.0.0" Type="Project">
  <TemplateData>
    <Name>NovaOryn Userland Library</Name>
    <Description>Create a reusable .NET-compatible NovaOryn userland library. Place it below Userland for automatic workspace discovery.</Description>
    <Icon>NovaOrynKernel.ico</Icon>
    <ProjectType>CSharp</ProjectType>
    <LanguageTag>csharp</LanguageTag>
    <PlatformTag>other</PlatformTag>
    <ProjectTypeTag>other</ProjectTypeTag>
    <TemplateID>NovaOryn.Project.UserlandLibrary</TemplateID>
    <DefaultName>NovaOrynUserlandLibrary</DefaultName>
    <SortOrder>23</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
  <TemplateContent>
    <Project File="Template.csproj" ReplaceParameters="true" TargetFileName="$safeprojectname$.csproj">
      <ProjectItem ReplaceParameters="true" OpenInEditor="true" TargetFileName="Library.cs">Library.cs</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>