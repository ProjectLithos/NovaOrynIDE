<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>$safeprojectname$</AssemblyName>
    <RootNamespace>$safeprojectname$</RootNamespace>
    <NovaOrynProject>true</NovaOrynProject>
    <NovaOrynProjectType>UserlandService</NovaOrynProjectType>
    <NovaOrynWorkspaceRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'NovaOrynProject.json'))</NovaOrynWorkspaceRoot>
  </PropertyGroup>
</Project>
